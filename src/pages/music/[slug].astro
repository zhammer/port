---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("music");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const bandcampSrc =
  entry.data.bandcampType === "album"
    ? `https://bandcamp.com/EmbeddedPlayer/album=${entry.data.bandcampId}/size=large/bgcol=ffffff/linkcol=1a1a1a/artwork=small/transparent=true/`
    : `https://bandcamp.com/EmbeddedPlayer/track=${entry.data.bandcampId}/size=large/bgcol=ffffff/linkcol=1a1a1a/artwork=small/transparent=true/`;
---

<Base title={entry.data.title}>
  <div class="music-embed">
    <iframe
      src={bandcampSrc}
      seamless
      style="border: 0; width: 100%; height: 120px;"
    >
    </iframe>
  </div>
  <h1>{entry.data.title}</h1>
  <div class="description">
    <Content />
  </div>
</Base>

<style>
  .music-embed {
    padding-bottom: 16px;
  }

  h1 {
    font-size: 14px;
    font-weight: 400;
    padding-bottom: 12px;
  }

  .description {
    line-height: 1.6;
  }
</style>
